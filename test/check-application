#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# NOT YET RUN: needs /dev/kvm and a Cockpit test image (TEST_OS) on which
# systemd-networkd manages the network. The dev container (README.md) is the
# tested path for now.
#
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib


@testlib.nondestructive
class TestNetworkd(testlib.MachineCase):
    def testBasic(self):
        b = self.browser
        m = self.machine

        # a dummy link that networkd configures, removed again on cleanup
        self.write_file("/run/systemd/network/50-cktest0.netdev", "[NetDev]\nName=cktest0\nKind=dummy\n")
        self.write_file("/run/systemd/network/50-cktest0.network",
                        "[Match]\nName=cktest0\n\n[Network]\nAddress=10.123.0.1/24\n")
        m.execute("networkctl reload")
        self.addCleanup(m.execute, "ip link del cktest0; networkctl reload")

        self.login_and_go("/networkd")
        b.wait_visible("#networking-interfaces")
        b.wait_in_text("#networking-interfaces tr[data-row-id='cktest0']", "10.123.0.1/24")
        b.wait_visible("#networking-graphs")


if __name__ == '__main__':
    testlib.test_main()
