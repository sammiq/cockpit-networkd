pkgname=cockpit-networkd
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit networking page for systemd-networkd'
arch=('x86_64')
url='https://github.com/sammiq/cockpit-networkd'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
